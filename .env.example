# Copiar a .env. Nunca subir .env a git.

# Bootstrap servers de Kafka, separados por coma.
# Local: un broker suelto en localhost:9092. EC2: DNS o IP privada de EC2-Kafka.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Token compartido con el BFF (header X-Internal-Token). Obligatorio para /api/kafka/**.
INTERNAL_TOKEN=cambiar-esto
